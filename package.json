{
  "name": "mining-order",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "矿业权项目派单管理平台",
  "scripts": {
    "dev": "concurrently -n server,web -c cyan,magenta \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch server/src/index.ts",
    "dev:web": "vite",
    "start": "tsx server/src/index.ts",
    "mysql:migrate": "tsx server/src/migrate-sqlite-to-mysql.ts",
    "mysql:init": "tsx server/src/init-mysql.ts",
    "build": "vite build",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test tests/*.test.mjs",
    "test:security": "node --import tsx --test tests/security.test.mjs tests/admin-delete.test.mjs",
    "test:board": "node --import tsx --test tests/board-layout.test.mjs",
    "test:archive": "node --test tests/archive-eol.test.mjs"
  },
  "dependencies": {
    "@ant-design/icons": "^5.5.2",
    "antd": "^5.22.5",
    "dayjs": "^1.11.13",
    "dotenv": "^18.0.9",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.2",
    "mysql2": "^3.24.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.5",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^1.4.13",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.17",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^5.4.11"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "esbuild@0.21.5": true
  }
}
