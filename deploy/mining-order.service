[Unit]
Description=Mining Order Platform
After=network.target

[Service]
Type=simple
User=miningorder
Group=miningorder
WorkingDirectory=/opt/mining-order/app
Environment=NODE_ENV=production
Environment=DB_CLIENT=mysql
Environment=HOST=127.0.0.1
Environment=PORT=3002
Environment=TRUST_PROXY=loopback
Environment=HOME=/var/lib/mining-order
Environment=PATH=/opt/order-record/node/bin:/usr/bin:/bin
EnvironmentFile=/etc/mining-order/app.env
ExecStart=/opt/order-record/node/bin/node --import tsx server/src/index.ts
Restart=on-failure
RestartSec=3s
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
UMask=0077

[Install]
WantedBy=multi-user.target
