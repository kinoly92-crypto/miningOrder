# 默认使用 sqlite。切换 MySQL 前请先完成迁移和核对。
DB_CLIENT=sqlite

# 云服务器经反向代理访问时，限制应用只监听本机。
HOST=127.0.0.1

# 可选：如未设置，首次初始化使用默认初始密码（普通账号 123456，sysadmin 4100282）。
# 首次登录后系统会强制要求修改密码；已有账号密码不会被修改。
ORDER_RECORD_INITIAL_PASSWORD=
ORDER_RECORD_INITIAL_ADMIN_PASSWORD=

# MySQL 8.0；填写服务器私网地址，勿提交真实密码。
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=your_mysql_user
MYSQL_PASSWORD=replace_with_a_private_password
MYSQL_DATABASE=your_empty_database
MYSQL_TLS=false
# MYSQL_CA_FILE=/absolute/path/to/ca.pem

# 生产环境须替换为独立、足够长的随机密钥，勿提交真实值。
JWT_SECRET=replace_with_a_long_random_secret
